# ============================================================================
# Backend Environment Variables Template
# Copy this file to `.env` and fill in your actual values.
# Never commit the real `.env` file — it contains secrets.
# ============================================================================

# ----------------------------------------------------------------------------
# MongoDB Connection
# ----------------------------------------------------------------------------
# Your MongoDB connection URI. Works with MongoDB Atlas (cloud) or a local
# MongoDB instance.
#
# Atlas format:
#   mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
#
# Local format:
#   mongodb://localhost:27017/ai-bot
#
MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/ai-bot?retryWrites=true&w=majority

# ----------------------------------------------------------------------------
# Groq (LLM) API
# ----------------------------------------------------------------------------
# Groq is used as the chat completion engine (via an OpenAI-compatible API).
# Get a free key from:  https://console.groq.com/keys
#
GROQ_API_KEY=gsk_your_groq_api_key_here

# (Optional) Groq model to use. Defaults to "llama-3.1-8b-instant" if unset.
# Popular options:
#   - llama-3.1-8b-instant     (fast, cheap, good for most use cases)
#   - llama-3.1-70b-versatile  (more capable, slower)
#   - mixtral-8x7b-32768       (Mistral-based alternative)
#
GROQ_MODEL=llama-3.1-8b-instant
