# ============================================================================
# Frontend Environment Variables Template
# Copy this file to `.env` (or `.env.local`) and adjust as needed.
# Variables must be prefixed with `VITE_` to be exposed to the client code.
# ============================================================================

# ----------------------------------------------------------------------------
# Backend API Base URL
# ----------------------------------------------------------------------------
# The URL where the Node.js backend server is running.
#
# - During local development, keep the default (http://localhost:5000).
# - When deploying the backend, replace with your production backend URL
#   (e.g. https://ai-bot-backend.vercel.app or your custom domain).
#
VITE_API_URL=http://localhost:5000
